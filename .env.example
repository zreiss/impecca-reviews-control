DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-mysql-database
# Optional: name of the raw Magento database for the product review route
MAGENTO_DB_NAME=magento
# Auth.js (password login)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret
# Login password; falls back to the default in src/routes/plugin@auth.ts when unset
AUTH_PASSWORD=myReviews102938!
# Comma-separated allowlist of IPs allowed to use the app; empty = allow all.
# Checked before the password, on every request.
AUTH_IP_CSV=
# Public URL of the deployed app (fixes redirects and CSRF checks behind a
# reverse proxy, e.g. https://my-app.onrender.com)
ORIGIN=https://my-app.onrender.com
AUTH_URL=https://my-app.onrender.com
